    {
      "id": "MVP:UNIT:EXISTENCE:CONCEPT:001",
      "chapter_id": "MVP:CH:EXISTENCE",
      "section_id": "MVP:SEC:EXISTENCE:INTRO",
      "type": "CONCEPT",
      "title": "O que existe neste contexto?",
      "revision": 1,
      "review_status": "PENDING_HOMOLOGATION",
      "provenance": {
        "kind": "SIYAYO_ADAPTATION",
        "source_sha256": "99c63e41b4bb3ad74133dbf8a272993494fcef1cd4cd398b8f0ed2256aaf553c",
        "note": "Nova proposta editorial baseada no eixo EXISTENCE da Master VIP; não é transcrição integral."
      },
      "related_unit_ids": [],
      "term_annotations": [],
      "asset_occurrence_ids": [],
      "body": {
        "en": "Use there + be to introduce the existence or presence of something. Choose is for a singular count noun or an uncountable noun, and are for a plural count noun.",
        "es": "Usamos there + be para presentar la existencia o presencia de algo. En español, hay se usa tanto con singular como con plural.",
        "pt": "Usamos there + be para apresentar a existência ou presença de algo. Em português, há é impessoal; existe e existem concordam com o termo apresentado."
      }
    },
    {
