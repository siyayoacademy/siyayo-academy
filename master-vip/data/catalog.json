      "examples": [
        {
          "id": "MVP:SENT:000004",
          "text": {
            "en": "There is a book on the table.",
            "es": "Hay un libro en la mesa.",
            "pt": "Há um livro na mesa."
          },
          "targets": {
            "en": "There is",
            "es": "Hay",
            "pt": "Há"
          }
        },
        {
          "id": "MVP:SENT:000005",
          "text": {
            "en": "The book is there.",
            "es": "El libro está allí.",
            "pt": "O livro está ali."
          },
          "targets": {
            "en": "there",
            "es": "allí",
            "pt": "ali"
          }
        },
        {
          "id": "MVP:SENT:000006",
          "text": {
            "en": "I have a book.",
            "es": "Tengo un libro.",
            "pt": "Eu tenho um livro."
          },
          "targets": {
            "en": "have",
            "es": "Tengo",
            "pt": "tenho"
          }
        }
      ],
      "body": {
        "en": "The first sentence introduces existence. In the second, there indicates a place. Have expresses possession in the third.",
        "es": "La primera oración presenta existencia. En la segunda, there indica lugar. Have expresa posesión en la tercera.",
        "pt": "A primeira frase apresenta existência. Na segunda, there indica lugar. Have expressa posse na terceira."
      }
