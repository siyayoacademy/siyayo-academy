            "rule": "WHO covers person reference broadly; WHOM marks formal object use and is often replaced by WHO in everyday English."
          },
          {
            "left": "WHOSE",
            "right": "WHO",
            "rule": "WHOSE asks possession; WHO asks person identity."
          },
          {
            "left": "WHERE",
            "right": "movement",
            "rule": "WHERE asks location or spatial information; motion comes from the verb/construction."
          },
          {
            "left": "WHEN",
            "right": "tense",
            "rule": "WHEN asks temporal information; tense grammatically locates the event."
          },
          {
            "left": "WHY",
            "right": "BECAUSE",
            "rule": "WHY asks for reason; BECAUSE introduces a causal response."
          },
          {
            "left": "HOW MUCH",
            "right": "HOW MANY",
            "rule": "HOW MUCH asks amount/price or non-count quantity; HOW MANY asks number of countable entities."
