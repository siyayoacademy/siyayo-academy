  "movementRules": {
    "original": "MOVEMENT = TO BE + VERB-ING / ongoing action simultaneous with speaking (Master VIP)",
    "complementary": "Physical displacement by go, walk, run is a semantic subtype of lexical ACTION / TO DO family for contrastive study",
    "grammarContrast": {
      "actionSimple": "We walk to the supermarket.",
      "actionNegative": "We do not walk to the supermarket.",
      "actionQuestion": "Do we walk to the supermarket?",
      "progressive": "We are walking to the supermarket."
    },
    "guard": "In the Master teaching classification, progressive is not silently renamed physical displacement. The lexical motion verb stays in the TO DO family for simple-tense auxiliary logic, while its progressive use belongs to the TO BE + ING structure."
  },
