{
  "version": "1.0.0",
  "id": "siyayo-stage-participation-map",
  "purpose": "Define which existing SIYAYO semantic and linguistic assets may participate in the Piano Stage, why they belong, how they are presented, and whether they are exploration-only or may later feed canonical evidence.",
  "principles": [
    "The stage presents and orchestrates; canonical adaptive authority evaluates.",
    "A content item enters the stage only when its source, learner action, actor roles, language coverage and evidence boundary are known.",
    "Semantic identity has precedence over shared musical-note identity whenever an exact content item is known.",
    "Language is a lens; collection and activity are independent dimensions.",
    "Roles are tendencies, not prisons; Experience bindings select active capabilities."
  ],
  "admissionContract": {
    "requiredQuestions": [
      "whatIsIt",
      "source",
      "learnerAction",
      "actorOrchestration",
      "languageCoverage",
      "evidenceRole",
      "destinationOrPurpose"
    ],
    "evidenceRoles": [
      "exploration-only",
      "opportunity-only",
      "candidate-evidence-after-explicit-learner-action",
      "canonical-only"
    ],
    "rejectWhen": [
      "source is unclear",
      "activity has no learner-facing purpose",
      "presentation would manufacture evidence",
      "language coverage is implied but not present",
      "navigation authority would be duplicated locally"
    ]
  },
