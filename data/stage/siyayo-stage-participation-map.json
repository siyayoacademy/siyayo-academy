  "stageRouting": {
    "version": "1.0",
    "order": [
      "collection",
      "activity",
      "language-lens",
      "actors",
      "learner-action",
      "pedagogical-result"
    ],
    "rules": [
      "Activities are contextual capabilities, not permanent stage buttons.",
      "14 Questions belongs to the Question Words collection.",
      "Semantic Cadence remains a reusable capability and is invoked only by an Experience/activity binding.",
      "Language lens never changes pedagogical authority.",
      "Presentation remains non-evaluative unless an explicit learner action is forwarded to canonical authority."
    ],
