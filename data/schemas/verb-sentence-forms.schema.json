{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verb-sentence-forms.schema.json",
  "title": "SIYAYO Academy Verb Sentence Forms Schema",
  "description": "Schema for the canonical Built-in Actions sentence matrix: one lexical verb across present, past and future, with affirmative, negative and interrogative trilingual realizations.",
  "type": "object",
  "required": ["$schema", "items"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/verb-sentence-forms.schema.json"
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/tenseItem" },
      "allOf": [
        { "contains": { "properties": { "tense": { "const": "present" } }, "required": ["tense"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "tense": { "const": "past" } }, "required": ["tense"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "tense": { "const": "future" } }, "required": ["tense"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "tenseItem": {
      "type": "object",
      "required": ["verb", "tense", "forms"],
      "properties": {
        "verb": { "type": "string", "minLength": 1 },
        "tense": { "type": "string", "enum": ["present", "past", "future"] },
        "forms": {
          "type": "object",
          "required": ["affirmative", "negative", "interrogative"],
          "properties": {
            "affirmative": { "$ref": "#/$defs/formUnit" },
            "negative": { "$ref": "#/$defs/formUnit" },
            "interrogative": { "$ref": "#/$defs/formUnit" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "formUnit": {
      "type": "object",
      "required": ["sentences", "targetWords"],
      "properties": {
        "sentences": { "$ref": "#/$defs/trilingualText" },
        "targetWords": { "$ref": "#/$defs/trilingualText" }
      },
      "additionalProperties": false
    },
    "trilingualText": {
      "type": "object",
      "required": ["en", "es", "pt"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}