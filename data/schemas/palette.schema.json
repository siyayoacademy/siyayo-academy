{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palette.schema.json",
  "title": "SIYAYO Academy Palette Schema",
  "description": "Schema for versioned SIYAYO color palettes with explicit semantic scope and usage roles.",
  "type": "object",
  "required": ["id", "type", "status", "version", "name", "colors"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:-v[0-9]+(?:\\.[0-9]+)*)?$"
    },
    "type": {
      "type": "string",
      "enum": ["brand", "pedagogical", "archetype", "experience"]
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "homologated", "retired"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "object",
      "required": ["en", "es", "pt"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "es": { "type": "string" },
        "pt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "hex", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "role": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "name": {
            "type": "object",
            "properties": {
              "en": { "type": "string" },
              "es": { "type": "string" },
              "pt": { "type": "string" }
            },
            "additionalProperties": false
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "recommended": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "avoid": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": { "type": "string" },
          "target": { "type": "string" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
