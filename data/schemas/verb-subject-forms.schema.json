{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verb-subject-forms.schema.json",
  "title": "SIYAYO Academy Verb Subject Forms Schema",
  "description": "Schema for the canonical Built-in Actions subject matrix: one lexical verb crossed with present, past and future; affirmative, negative and interrogative forms; eight grammatical subject positions; and EN/ES/PT realizations.",
  "type": "object",
  "required": ["$schema", "version", "verb", "tenses"],
  "properties": {
    "$schema": { "type": "string", "const": "../../schemas/verb-subject-forms.schema.json" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "verb": { "type": "string", "minLength": 1 },
    "tenses": {
      "type": "object",
      "required": ["present", "past", "future"],
      "properties": {
        "present": { "$ref": "#/$defs/tenseUnit" },
        "past": { "$ref": "#/$defs/tenseUnit" },
        "future": { "$ref": "#/$defs/tenseUnit" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tenseUnit": {
      "type": "object",
      "required": ["forms"],
      "properties": {
        "forms": {
          "type": "object",
          "required": ["affirmative", "negative", "interrogative"],
          "properties": {
            "affirmative": { "$ref": "#/$defs/subjectList" },
            "negative": { "$ref": "#/$defs/subjectList" },
            "interrogative": { "$ref": "#/$defs/subjectList" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "subjectList": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/firstSingular" },
        { "$ref": "#/$defs/secondSingular" },
        { "$ref": "#/$defs/thirdSingularMasculine" },
        { "$ref": "#/$defs/thirdSingularFeminine" },
        { "$ref": "#/$defs/thirdSingularNeuter" },
        { "$ref": "#/$defs/firstPlural" },
        { "$ref": "#/$defs/secondPlural" },
        { "$ref": "#/$defs/thirdPlural" }
      ],
      "items": false
    },
    "subjectUnit": {
      "type": "object",
      "required": ["subject", "sentences", "targetWords"],
      "properties": {
        "subject": { "type": "string" },
        "sentences": { "$ref": "#/$defs/trilingualText" },
        "targetWords": { "$ref": "#/$defs/trilingualText" }
      },
      "additionalProperties": false
    },
    "firstSingular": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "first-singular" } } }] },
    "secondSingular": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "second-singular" } } }] },
    "thirdSingularMasculine": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "third-singular-masculine" } } }] },
    "thirdSingularFeminine": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "third-singular-feminine" } } }] },
    "thirdSingularNeuter": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "third-singular-neuter" } } }] },
    "firstPlural": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "first-plural" } } }] },
    "secondPlural": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "second-plural" } } }] },
    "thirdPlural": { "allOf": [{ "$ref": "#/$defs/subjectUnit" }, { "properties": { "subject": { "const": "third-plural" } } }] },
    "trilingualText": {
      "type": "object",
      "required": ["en", "es", "pt"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}