{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verb-subject-forms.schema.json",
  "title": "SIYAYO Academy Verb Subject Forms Schema",
  "description": "Schema for crossing a lexical verb with tenses, sentence forms and grammatical subjects while preserving trilingual realizations.",
  "type": "object",
  "required": ["$schema", "version", "verb", "tenses"],
  "properties": {
    "$schema": { "type": "string", "const": "../../schemas/verb-subject-forms.schema.json" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "verb": { "type": "string", "minLength": 1 },
    "tenses": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "present": { "$ref": "#/$defs/tenseUnit" },
        "past": { "$ref": "#/$defs/tenseUnit" },
        "future": { "$ref": "#/$defs/tenseUnit" },
        "present-period": { "$ref": "#/$defs/tenseUnit" },
        "past-period": { "$ref": "#/$defs/tenseUnit" },
        "future-period": { "$ref": "#/$defs/tenseUnit" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tenseUnit": {
      "type": "object",
      "required": ["forms"],
      "properties": {
        "forms": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "affirmative": { "$ref": "#/$defs/subjectList" },
            "negative": { "$ref": "#/$defs/subjectList" },
            "interrogative": { "$ref": "#/$defs/subjectList" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "subjectList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "sentences", "targetWords"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "sentences": { "$ref": "#/$defs/trilingualText" },
          "targetWords": { "$ref": "#/$defs/trilingualText" }
        },
        "additionalProperties": false
      }
    },
    "trilingualText": {
      "type": "object",
      "required": ["en", "es", "pt"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}